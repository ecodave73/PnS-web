{
  "name": "paint-and-sip-events",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "npm run check",
    "test": "node --experimental-strip-types --test tests/worker.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
