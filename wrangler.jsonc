{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paint-and-sip-events",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "paintandsipevents.com.au/*",
      "zone_name": "paintandsipevents.com.au"
    },
    {
      "pattern": "www.paintandsipevents.com.au/*",
      "zone_name": "paintandsipevents.com.au"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "734102816",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
