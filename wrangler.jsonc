{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paint-and-sip-events",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "paintandsipevents.com.au/*",
      "zone_name": "paintandsipevents.com.au"
    },
    {
      "pattern": "www.paintandsipevents.com.au/*",
      "zone_name": "paintandsipevents.com.au"
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
